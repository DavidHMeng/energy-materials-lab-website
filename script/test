#!/usr/bin/env bash
set -euo pipefail

BUNDLER_VERSION="2.5.6"
BASEURL="${BASEURL:-}"
ORIGIN="${ORIGIN:-https://jliang.eitech.edu.cn}"
CANONICAL_ORIGIN="${CANONICAL_ORIGIN:-https://jliang.eitech.edu.cn}"
SITE_ENVIRONMENT="${SITE_ENVIRONMENT:-production}"
JEKYLL_CONFIG="${JEKYLL_CONFIG:-_config.yml,_config.production.yml}"
DESTINATION="${DESTINATION:-_site}"
REQUIRE_VERSION="${REQUIRE_VERSION:-false}"

python scripts/validate_content.py
python scripts/test_citation_registry.py
python scripts/test_publication_cms.py
python scripts/test_citation_page_independence.py
python scripts/test_publication_image_isolation.py
python scripts/test_cms_schema.py
python scripts/test_cms_input_contract.py
python scripts/test_cms_record_independence.py
python scripts/test_page_content.py
python scripts/test_translation.py
python scripts/test_translation_coverage.py
python scripts/test_carousel_layout.py
python scripts/test_research_layout.py
python scripts/check_translation_coverage.py
python scripts/translate_content.py --dry-run
bundle _${BUNDLER_VERSION}_ exec ruby scripts/test_translation_fallback.rb
JEKYLL_ENV=production bundle _${BUNDLER_VERSION}_ exec jekyll build \
  --config "$JEKYLL_CONFIG" --destination "$DESTINATION" --trace "$@"
check_args=("$DESTINATION" --baseurl "$BASEURL" --origin "$ORIGIN" \
  --canonical-origin "$CANONICAL_ORIGIN" --environment "$SITE_ENVIRONMENT")
if [[ "$REQUIRE_VERSION" == "true" ]]; then
  check_args+=(--require-version)
fi
python scripts/check_generated_site.py "${check_args[@]}"

htmlproofer_args=("$DESTINATION" --disable-external --ignore-urls "/example\\.edu/")
if [[ -n "$BASEURL" && "$BASEURL" != "/" ]]; then
  htmlproofer_args+=(--swap-urls "^${BASEURL}/:/")
fi
bundle _${BUNDLER_VERSION}_ exec htmlproofer "${htmlproofer_args[@]}"
